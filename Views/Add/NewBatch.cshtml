@model GreenBowlApp.Models.ViewModels.BatchControlModel
@{
    ViewData["Title"] = "New Batch";
}

<!-- menu steps -->
<div class="wizard-steps mb-4">
    <div class="step active"><span>1</span> Batch Control</div>
    <div class="step"><span>2</span> Packaging</div>
    <div class="step"><span>3</span> Processing</div>
    <div class="step"><span>4</span> X-Ray</div>
</div>

<div class="mb-3">
    <h4 class="fw-bold">@Model.ProductName - Batch Creation</h4>
    <div class="text-muted">Step 1 of 4</div>
</div>

<form asp-action="NewBatch" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ProductName" />

    <!--Product Batching Control form -->
    <div class="card dashboard-card p-4 mb-4">
        <h5 class="fw-bold mb-4">Product Batching Control</h5>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Batch No</label>
                <input asp-for="BatchNo" class="form-control form-control-lg" />
                <div class="text-danger small">@Html.ValidationMessageFor(m => m.BatchNo)</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Production Supervisor</label>
                <select asp-for="SupervisorEmployeeId" class="form-select form-select-lg">
                    <option value="0">Select employee</option>
                    @foreach (var s in Model.Supervisors)
                    {
                        <option value="@s.EmployeeId">@s.Name</option>
                    }
                </select>
                <div class="text-danger small">@Html.ValidationMessageFor(m => m.SupervisorEmployeeId)</div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Start Batching Time</label>
                <input asp-for="StartBatchTime" type="time" class="form-control form-control-lg" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Finish Time Batching</label>
                <input asp-for="FinishBatchTime" type="time" class="form-control form-control-lg" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Production Date</label>
                <input asp-for="ProductionDate" type="date" class="form-control form-control-lg" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Effective Date</label>
                <input asp-for="EffectiveDate" type="date" class="form-control form-control-lg" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Batch Weight (KG)</label>
                <input asp-for="BatchWeight" type="number" step="0.01" class="form-control form-control-lg" value="0" />
            </div>

            <div class="col-md-12">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" rows="4" class="form-control"></textarea>
            </div>
        </div>
    </div>

    <!--Ingredients table -->
    <div class="mb-3">
        <h5 class="fw-bold">Ingredients</h5>
    </div>

    <div class="card dashboard-card p-0 overflow-hidden">
        <div class="table-wrapper">
            <table class="table ingredients-table mb-0">
                <thead>
                    <tr>
                        <th>Ingredients</th>
                        <th>Allergens</th>
                        <th>Hygienic Condition</th>
                        <th>Lot Number</th>
                        <th>Expiry Date</th>
                        <th>Amount per Batch (KG)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Ingredients.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Ingredients[i].IngredientName
                                <input type="hidden" asp-for="Ingredients[@i].IngredientId" />
                                <input type="hidden" asp-for="Ingredients[@i].IngredientName" />
                            </td>

                            <td>
                                <input asp-for="Ingredients[@i].Allergens" class="form-control" />
                            </td>

                            <td>
                                <select asp-for="Ingredients[@i].HygienicCondition" class="form-select">
                                    <option value="">Select</option>
                                    <option>Good</option>
                                    <option>Average</option>
                                    <option>Bad</option>
                                </select>
                            </td>

                            <td>
                                <input asp-for="Ingredients[@i].LotNumber" class="form-control" />
                            </td>

                            <td>
                                <input asp-for="Ingredients[@i].ExpiryDate" type="date" class="form-control" />
                            </td>

                            <td>
                                <input asp-for="Ingredients[@i].AmountPerBatchKg" type="number" step="0.01" class="form-control" value="0" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- submit option -->
    <div class="d-flex justify-content-between mt-4">
        <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Index">Cancel</a>
        <button type="submit" class="btn btn-success rounded-pill px-4">
            Next <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>
</form>