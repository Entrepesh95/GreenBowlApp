@model List<GreenBowlApp.Models.Product>
@{
    ViewData["Title"] = "Add";
    int selectedId = (int)(ViewBag.SelectedId ?? 0);
}

<!-- menu bar at the top -->
<div class="add-tabs mb-4">
    <a class="add-tab active" href="#">
        <i class="bi bi-clipboard-plus me-2"></i> New Batch
    </a>
    <a class="add-tab" href="/Add/PreEquipment">
        <i class="bi bi-gear me-2"></i> Pre-Op Form Equipment
    </a>
    
    <a class="add-tab" href="/Add/ReceivedIngredientCreateForm">
        <i class="bi bi-truck me-2"></i> Received ingredients
    </a>
</div>

<!-- product cards -->
<div class="card dashboard-card p-4">
    <h4 class="fw-bold mb-4">Select Product</h4>

    <div class="row g-4">
        @foreach (var p in Model)
        {
            var active = p.ProductId == selectedId;

            <div class="col-md-3">
                <a class="select-product-card @(active ? "select-product-active" : "")"
                   href="/Add/NewBatch?productId=@p.ProductId">

                    <div class="select-product-icon">
                        <i class="bi bi-box"></i>
                    </div>

                    <div class="select-product-name">@p.ProductName</div>
                </a>
            </div>
        }
    </div>
</div>