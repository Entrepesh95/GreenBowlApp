@{
    
    ViewData["Title"] = "Categories";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1">Categories</h3>
    <div class="text-muted"> control systems and forms</div>
</div>

<div class="row g-4">

    @*equipment control div*@
    <div class="col-md-3">
        <a class="text-decoration-none" href="/Categories/EquipmentControl">
            <div class="card dashboard-card p-4 text-center h-100">
                <div class="icon-box bg-success-subtle text-success mx-auto mb-3">
                    <i class="bi bi-gear-fill"></i>
                </div>
                <h6 class="fw-bold mb-1">Equipment Control</h6>
                <div class="text-muted small">Equipment control forms</div>
            </div>
        </a>
    </div>

    @*packagingh control div*@
    <div class="col-md-3">
        <a class="text-decoration-none" href="/Categories/PackagingControl">
            <div class="card dashboard-card p-4 text-center h-100">
                <div class="icon-box bg-primary-subtle text-primary mx-auto mb-3">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h6 class="fw-bold mb-1">Packaging Control</h6>
                <div class="text-muted small">Packaging control forms</div>
            </div>
        </a>
    </div>

    @*processing control div*@
    <div class="col-md-3">
        <a class="text-decoration-none" href="/Categories/ProcessingControl">
            <div class="card dashboard-card p-4 text-center h-100">
