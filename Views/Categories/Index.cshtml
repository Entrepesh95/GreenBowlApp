    <div class="col-md-3">
        <a class="text-decoration-none" href="/Add/ReceivedIngredients">
            <div class="card dashboard-card p-4 text-center h-100">
                <div class="icon-box bg-success-subtle text-success mx-auto mb-3">
                    <i class="bi bi-truck"></i>
                </div>
