@model List<GreenBowlApp.Models.ViewModels.PreEquipmentModel>
@{
    ViewData["Title"] = "Equipment Control";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="fw-bold mb-1">Equipment Control</h4>
        <div class="text-muted">Pre-Op equipment forms</div>
    </div>

    <a href="/Add/PreEquipment" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Add New Pre-Equipment Form
    </a>
</div>

@*table to displat the forms submitted from the add section*@
<div class="card dashboard-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Equip ID</th>
                    <th>Batch ID</th>
                    <th>Employee</th>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Equipment Name</th>
                    <th>Condition</th>
                    <th>Action Taken</th>
                    <th>Gluten Test</th>
                    <th>Packaging Machine</th>
                    <th>Comments</th>
                </tr>
            </thead>

            <tbody>
                @*a loop that uses fields from the model preeqipment model*@
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.EquipId</td>
                        <td>@x.BatchId</td>
                        <td>@(string.IsNullOrWhiteSpace(x.EmployeeName) ? x.EmployeeId.ToString() : x.EmployeeName)</td>
                        <td>@(x.StartTime ?? "")</td>
                        <td>@(x.FinishTime ?? "")</td>
                        <td>@x.EquipmentName</td>
                        <td>@x.ConditionOfEquipment</td>
                        <td>@x.ActionTaken</td>
                        <td>@x.GlutenTest</td>
                        <td>@x.PackagingMachine</td>
                        <td>@x.Comments</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>