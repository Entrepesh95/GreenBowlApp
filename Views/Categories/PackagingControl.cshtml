@model List<GreenBowlApp.Models.ViewModels.BatchPackagingModel>
@{
    ViewData["Title"] = "Packaging Control";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="fw-bold mb-1">Packaging Control</h4>
        <div class="text-muted">Submitted packaging forms</div>
    </div>

    <a href="/Add" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Add New Packaging form
    </a>
</div>

@*table to display packaging forms submitted from the add page*@
<div class="card dashboard-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pack ID</th>
                    <th>Batch ID</th>
                    <th>Employee</th>
                    <th>Production Date</th>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Time Checked</th>
                    <th>Hygiene</th>
                    <th>Sealing</th>
                    <th>Packaging Type</th>
                    <th>Qty Pouches</th>
                    <th>Comments</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.PackId</td>
                        <td>@x.BatchId</td>
                        <td>@(string.IsNullOrWhiteSpace(x.EmployeeName) ? x.EmployeeId.ToString() : x.EmployeeName)</td>
                        <td>@(x.ProductionDate?.ToString("yyyy-MM-dd") ?? "")</td>
                        <td>@(x.StartTimeFilling ?? "")</td>
                        <td>@(x.FinishTimeFilling ?? "")</td>
                        <td>@(x.TimeChecked ?? "")</td>
                        <td>@x.HygienicCondition</td>
                        <td>@x.SealingCondition</td>
                        <td>@x.PackagingType</td>
                        <td>@(x.QtyPouchMade?.ToString() ?? "")</td>
                        <td>@x.Comments</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>