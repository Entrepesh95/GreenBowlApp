@model List<GreenBowlApp.Models.ViewModels.BatchProcessingModel>
@{
    ViewData["Title"] = "Processing Control";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="fw-bold mb-1">Processing Control</h4>
        <div class="text-muted">Submitted processing forms</div>
    </div>

    <a href="/Add" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Add New processing form
    </a>
</div>

@*t able to display the processes forms*@
<div class="card dashboard-card p-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Process ID</th>
                    <th>Batch ID</th>
                    <th>Employee</th>
                    <th>Production Date</th>
                    <th>Start</th>
                    <th>Finish</th>
                    <th>Time Checked</th>
                    <th>Alarm Autoclave</th>
                    <th>Reason Comment</th>
                    <th>Action Taken</th>
                    <th>Comments</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.ProcessId</td>
                        <td>@x.BatchId</td>
                        <td>@(string.IsNullOrWhiteSpace(x.EmployeeName) ? x.EmployeeId.ToString() : x.EmployeeName)</td>
                        <td>@(x.ProductionDate?.ToString("yyyy-MM-dd") ?? "")</td>
                        <td>@(x.StartTime ?? "")</td>
                        <td>@(x.FinishTime ?? "")</td>
                        <td>@(x.TimeChecked ?? "")</td>
                        <td>@x.AlarmAutoclave</td>
                        <td>@x.ReasonComment</td>
                        <td>@x.ActionTakenComment</td>
                        <td>@x.Comments</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>