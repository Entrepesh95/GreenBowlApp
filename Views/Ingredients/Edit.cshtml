@*this form also call the ingredients model to edit the ingrdedient*@
@model GreenBowlApp.Models.Ingredient
@{
    ViewData["Title"] = "Edit Ingredient";
}

@*edit form*@
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="fw-bold mb-1">Edit Ingredient</h2>
        <p class="text-muted mb-0">Update ingredient detail</p>
    </div>
    <a class="btn btn-light rounded-pill px-4" asp-action="Index">Back</a>
</div>

<div class="card dashboard-card p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="IngredientId" />

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Ingredient ID</label>
                <input asp-for="IngredientId" class="form-control" disabled />
            </div>

            <div class="col-md-5">
                <label class="form-label">Ingredient Name</label>
                <input asp-for="ItemName" class="form-control" />
                <div class="text-danger small">@Html.ValidationMessageFor(m => m.ItemName)</div>
            </div>

            <div class="col-md-4">
                <label class="form-label">Lot Number</label>
                <input asp-for="LotNumber" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Qty</label>
                <input asp-for="Quantity" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Weight/Bag</label>
                <input asp-for="WeightPerBag" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Location</label>
                <input asp-for="Location" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Company Made</label>
                <input asp-for="CompanyMade" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Country Origin</label>
                <input asp-for="CountryOrigin" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Expiry Date</label>
                <input asp-for="ExpiryDate" type="date" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Amount Used</label>
                <input asp-for="AmountUsed" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Amount Remain</label>
                <input asp-for="AmountRemain" class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Date Received</label>
                <input asp-for="DateReceived" type="date" class="form-control" />
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success rounded-pill px-4">
                <i class="bi bi-check2 me-2"></i> Save update
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>