@model List<GreenBowlApp.Models.Staff>
@{
    ViewData["Title"] = "Employees";
    var totalEmployees = (int)(ViewBag.TotalEmployees ?? 0);
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="fw-bold mb-1">Employees</h2>
        <p class="text-muted mb-0">Manage company employees</p>
    </div>

    <a class="btn btn-success px-4 py-2 rounded-pill shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg me-2"></i> Add Employee
    </a>
</div>

<!-- Total Employees Card -->
<div class="card dashboard-card p-4 mb-4">
    <div class="d-flex align-items-center">
        <div class="icon-circle bg-success me-3" style="background:#dcfce7 !important;">
            <i class="bi bi-telephone text-success"></i>
        </div>
        <div>
            <div class="text-muted">Total Employees</div>
            <div class="fw-bold fs-2">@totalEmployees</div>
        </div>
    </div>
</div>

<!-- Search Bar -->
<div class="card dashboard-card p-3 mb-4">
    <div class="d-flex align-items-center">
        <input id="employeeSearch" type="text" class="form-control border-0"
               placeholder="Search employees..." />
        <i class="bi bi-search text-muted ms-2"></i>
    </div>
</div>

<!-- Employee Cards Grid -->
<div class="row g-4" id="employeesGrid">
    @foreach (var e in Model)
    {
        var empCode = $"EMP-{e.EmployeeId:000}";
        var full = $"{e.FullName} {e.LastName}";
        var role = string.IsNullOrWhiteSpace(e.EmployeeRole) ? "Employee" : e.EmployeeRole;

        <div class="col-md-4 employee-card-col" data-text="@($"{full} {role} {e.Email}".ToLower())">
            <div class="card dashboard-card p-4 employee-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold fs-5">@full</div>
                        <div class="text-muted">@role</div>
                        <div class="text-muted small mt-1">Added: @DateTime.Now.ToString("M/d/yyyy")</div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="badge emp-badge">@empCode</span>

                        <a class="action-icon text-success" asp-action="Edit" asp-route-id="@e.EmployeeId" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@e.EmployeeId"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Delete this employee?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn p-0 action-icon text-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="mt-4 text-muted">
                 
                    <div class="d-flex align-items-center">
                        <i class="bi bi-envelope me-2"></i>
                        <span>@(e.Email ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Simple client-side search (beginner-friendly)
        const search = document.getElementById("employeeSearch");
        const cards = document.querySelectorAll(".employee-card-col");

        search.addEventListener("keyup", function () {
            const q = search.value.toLowerCase().trim();
            cards.forEach(c => {
                const text = c.getAttribute("data-text");
                c.style.display = text.includes(q) ? "" : "none";
            });
        });
    </script>
}