@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GreenBowlApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GreenBowlApp.styles.css" asp-append-version="true" />
    
</head>

<body>
    <div class="d-flex">

        <!-- Sidebar -->
        <div class="sidebar p-3 sidebar-sticky">
            <div class="mb-4">
                <h4 class="text-white fw-bold mb-1">Green Bowl System</h4>
                <div class="text-muted small">Inventory Management</div>
            </div>

            
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link side-link @(currentController == "Dashboard" ? "active-link" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link side-link @(currentController == "Ingredients" ? "active-link" : "")"
                       asp-controller="Ingredients" asp-action="Index">
                        <i class="bi bi-box-seam me-2"></i> Ingredients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link side-link @(currentController == "Products" ? "active-link" : "")"
                       asp-controller="Products" asp-action="Index">
                        <i class="bi bi-grid me-2"></i> Products
                    </a>
                </li>

                @* this creates only access to the user with the role of manager *@
                @if (User.IsInRole("Manager"))
                {
                    <li class="nav-item">
                        <a class="nav-link side-link @(currentController == "Employees" ? "active-link" : "")"
                           asp-controller="Employees" asp-action="Index">
                            <i class="bi bi-people me-2"></i> Employees
                        </a>
                    </li>
                }
                
                <li class="nav-item">
                    <a class="side-link @(currentController == "Categories" ? "active-link" : "")"
                       asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap me-2"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="side-link @(currentController == "Add" ? "active-link" : "")"
                       asp-controller="Add" asp-action="Index">
                        <i class="bi bi-plus-circle me-2"></i> Add
                    </a>
                </li>
            </ul>

            <!-- bottom of the side bar -->
            <div>
                <hr class="sidebar-divider" />

                <div class="d-flex align-items-center gap-3 px-2 py-3">
                    <div class="user-avatar">U</div>
                    <div>
                        <div class="text-white fw-semibold">User</div>
                        <div class="text-muted small">Manager</div>
                    </div>
                </div>

                <form asp-controller="Login" asp-action="Logout" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-link text-decoration-none text-light p-0">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- this will render the pages next to the side bar -->
        <div class="flex-fill p-4" style="min-width:0;">
            @RenderBody()
        </div>

    </div>
    @* this script will allow to render sections using JS for this case we are using them in the charts *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
